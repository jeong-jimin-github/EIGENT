HOST=0.0.0.0
PORT=3100

# Optional comma-separated cross-origin clients. Production PWA is same-origin.
# EIGENT_ALLOWED_ORIGINS=https://eigent.example.com

# Optional alternate path to a prebuilt web client.
# EIGENT_WEB_ROOT=/opt/eigent/web

# Provider credentials (future adapters).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Durable server state. Defaults to the platform user data directory.
# EIGENT_DATA_DIR=/var/lib/eigent
# EIGENT_STATE_DB=/var/lib/eigent/eigent.db

# Optional Antigravity model override; auto-discovery is used when unset.
# EIGENT_ANTIGRAVITY_MODELS=Gemini 3.7 Flash (High),Gemini 3.1 Pro (High)
# Optional isolated Antigravity settings/session home; OS keyring auth is still reused.
# EIGENT_ANTIGRAVITY_HOME=/var/lib/eigent/antigravity-home

# Persistent shared browser profile (Issue #20).
# EIGENT_BROWSER_EXECUTABLE=/usr/bin/google-chrome
# EIGENT_BROWSER_PROFILE_DIR=/var/lib/eigent/browser/profile
# EIGENT_BROWSER_DOWNLOAD_DIR=/var/lib/eigent/browser/downloads
# EIGENT_BROWSER_UPLOAD_DIR=/var/lib/eigent/browser/uploads
# EIGENT_BROWSER_DEBUG_PORT=9223
# EIGENT_BROWSER_WORKER_PORT=9224
# EIGENT_BROWSER_HEADLESS=true
# EIGENT_BROWSER_STARTUP_TIMEOUT_MS=15000
