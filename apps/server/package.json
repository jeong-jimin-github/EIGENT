{
	"name": "@palot/server",
	"version": "0.4.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./src/index.ts"
		},
		"./client": {
			"types": "./dist/src/client.d.ts",
			"default": "./src/client.ts"
		}
	},
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"build": "tsc && bun build src/index.ts --outdir dist --target bun --external node-pty",
		"build:types": "tsc",
		"check-types": "tsgo --noEmit",
		"start": "bun run dist/index.js"
	},
	"dependencies": {
		"@opencode-ai/sdk": "^1.2.1",
		"hono": "4.11.9",
		"node-pty": "^1.1.0",
		"simple-git": "^3.30.0",
		"@eigent/agent-core": "workspace:*",
		"@eigent/agent-codex": "workspace:*",
		"@eigent/agent-claude": "workspace:*",
		"@eigent/agent-openai": "workspace:*",
		"@eigent/agent-anthropic": "workspace:*",
		"@eigent/agent-antigravity": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.2.14",
		"typescript": "^5.8.3"
	}
}
